# Environment Configuration
# Copy to .env and fill with actual values

# === Database ===
PG_PASSWORD=dev_postgres_pw_change_me_in_prod

# === Redis ===
REDIS_PASSWORD=dev_redis_pw_change_me_in_prod

# === JWT & Security ===
JWT_SECRET=dev_jwt_secret_change_me_in_prod

# === Node Environment ===
NODE_ENV=development

# === API URLs ===
API_URL=http://localhost:3001
WS_URL=ws://localhost:3001
FRONTEND_URL=http://localhost:3000

# === Logging ===
LOG_LEVEL=debug
